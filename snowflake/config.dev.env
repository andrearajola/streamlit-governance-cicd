# Streamlit + Skill CI/CD - environment "dev". Edit, then: ./install.sh <snow-connection> dev
# Verisure: this file is used against the DEV account.
env=dev
env_db=DB_STREAMLIT_DEV
role_suffix=_DEV
admin_db=DB_STREAMLIT_ADMIN
pipeline_wh=COMPUTE_WH
pypi_eai=STREAMLIT_PYPI_EAI
cicd_role=STREAMLIT_CICD_DEV
svc_user=SVC_STREAMLIT_CICD_DEV
# OIDC subject = GitHub repo + GitHub environment (case-sensitive, no wildcards)
svc_subject=repo:andrearajola/streamlit-governance-cicd:environment:dev
network_policy=STREAMLIT_CICD_GITHUB_NP
# Compute pool defaults per team (onboard_team.sh can override max_nodes)
instance_family=CPU_X64_XS
max_nodes=1
