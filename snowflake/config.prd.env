# Streamlit + Skill CI/CD - environment "prd". Edit, then: ./install.sh <snow-connection> prd
# Verisure: this file is used against the PRD account.
env=prd
env_db=DB_STREAMLIT
role_suffix=
admin_db=DB_STREAMLIT_ADMIN
pipeline_wh=COMPUTE_WH
pypi_eai=STREAMLIT_PYPI_EAI
cicd_role=STREAMLIT_CICD
svc_user=SVC_STREAMLIT_CICD_PRD
svc_subject=repo:andrearajola@102627835/streamlit-governance-cicd@1464086398:environment:prd
network_policy=STREAMLIT_CICD_GITHUB_NP
instance_family=CPU_X64_XS
max_nodes=2
