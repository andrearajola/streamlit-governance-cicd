# =====================================================================
# Skill CI/CD - configuration. Edit, then: ./install.sh <snow-connection>
# Adapted from the SEAT skill CI/CD. Differences:
#   - GitHub Actions uploads skills/ to a stage (no Git repository object, no PAT in Snowflake)
#   - the pipeline creates the per-skill roles itself (SP_SKILL_CREATE_ROLES, owner's rights)
#   - OIDC service users (shared with the Streamlit CI/CD) instead of a key pair
# =====================================================================
db=DB_COCO_SKILLS
dev_schema=SKILLS_DEV
prd_schema=SKILLS_PRD
cicd_schema=SKILLS_CICD

# Roles
cicd_role=SKILL_CICD             # pipeline: deploys and owns the skills
dev_role=SKILL_DEV               # generic: can use ALL DEV skills
users_role=SKILL_USERS           # generic: can use ALL PRD skills
# Per skill (created by the pipeline): <SKILL>_SKILL_DEV and <SKILL>_SKILL_USERS, rolled up to the generic roles

warehouse=COMPUTE_WH
dev_branch=dev
prd_branch=main

# GitHub Actions service users that run the skill sync (both environments)
svc_user_dev=SVC_STREAMLIT_CICD_DEV
svc_user_prd=SVC_STREAMLIT_CICD_PRD

# Release email
email_int=SKILLS_EMAIL_INT
notify_exclude_roles='ACCOUNTADMIN', 'SYSADMIN', 'SECURITYADMIN', 'USERADMIN', 'ORGADMIN', 'GLOBALORGADMIN', 'SKILL_USERS'
